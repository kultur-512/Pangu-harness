    "@types/node": "^22.0.0",
    "@types/prompts": "^2.4.9",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0"
  },
  "dependencies": {},
  "peerDependencies": {
    "react": "^18.3.0"
  },
  "optionalDependencies": {
    "chalk": "^5.3.0",
    "ora": "^8.0.1",
    "prompts": "^2.4.2",
    "ink": "^5.0.0",
    "react": "^18.3.0"
  }
}
