{
  "name": "panshalach",
  "version": "0.6.1",
  "description": "烛龙（Zhulong）· 内部代号 Panshalach（盤沙拉克）：基于 openPangu 的记忆增强长程上下文智能体——记忆卡 + 会话资产（resume/branch/compact）+ 真实工具执行与验证铁律，面向软件工程长期维护等长周期任务场景。",
  "type": "module",
  "main": "dist/PanshalachChaser.js",
  "bin": {
    "zhulong": "dist/cli.js",
    "panshalach": "dist/cli.js",
    "zorge": "dist/cli.js"
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsx watch src/cli.ts",
    "cli": "tsx src/cli.ts",
    "test": "node --test --import tsx \"tests/**/*.test.ts\"",
    "simulate": "tsx src/cli.ts simulate --issue \"example issue\" --workspace .",
    "dogfood": "panshalach --headless run"
  },
  "keywords": ["panshalach", "openpangu", "memory", "coding-agent", "engineering", "terminal", "automation", "long-context", "memory-augmented-agent", "cli", "mcp"],
